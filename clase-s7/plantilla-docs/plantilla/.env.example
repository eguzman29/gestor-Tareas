# Copien este archivo como .env (o usen "set" en cmd) y pongan sus valores reales.
# NUNCA suban el .env real: agréguenlo a .gitignore.

# Secreto para firmar los tokens JWT (una cadena larga y aleatoria)
JWT_SECRETO=

# Páginas que pueden usar la API desde el navegador (CORS), separadas por coma
CORS_ORIGENES=http://127.0.0.1:5500,http://localhost:5500

# Servicio externo [COMPLETAR: cuál]
[COMPLETAR: NOMBRE_DE_LA_CLAVE]=

# [COMPLETAR: otras variables de su proyecto: base de datos, puerto...]
