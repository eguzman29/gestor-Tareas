# Variables de entorno del Gestor de tareas
# PHP no lee este archivo solo: define cada variable con export en la terminal
# donde arrancas la API (Mac/Linux) o con set (Windows cmd). Nunca subas valores reales.

# Secreto para firmar los tokens JWT (HS256). Obligatoria: sin ella la API responde 503.
JWT_SECRET=pon-aqui-un-secreto-largo

# Páginas que pueden usar la API desde el navegador (CORS), separadas por coma. Nunca *
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# Clave de Google AI Studio para los endpoints con IA (/reportes y /tareas/prioridad).
# Sin ella esos dos responden 503 (solo si se llama a Google); el resto de la API funciona.
GEMINI_API_KEY=

# Modelo de Gemini (opcional)
GEMINI_MODELO=gemini-flash-lite-latest

# A dónde llama la API para la IA. Vacío = Google. Para probar fallas: http://127.0.0.1:9000
EXTERNO_URL=
