{
  "openapi": "3.0.3",
  "info": {
    "title": "Gestor personal de tareas",
    "version": "1.0.0",
    "description": "CRUD de tareas con SQLite. Todos los errores responden {\"error\", \"detalles\"}."
  },
  "security": [{"bearerAuth": []}],
  "servers": [
    {"url": "http://127.0.0.1:8010", "description": "Servidor local PHP"}
  ],
  "tags": [
    {"name": "auth", "description": "Autenticación"},
    {"name": "tasks", "description": "Tareas del usuario autenticado"}
  ],
  "paths": {
    "/tasks": {
      "get": {
        "tags": ["tasks"],
        "summary": "Listar tareas",
        "responses": {
          "200": {
            "description": "Lista de tareas del usuario actual",
            "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Task"}}}}
          },
          "404": {"$ref": "#/components/responses/NotFound"},
          "422": {"$ref": "#/components/responses/ValidationError"}
        }
      },
      "post": {
        "tags": ["tasks"],
        "summary": "Crear tarea",
        "description": "Crea una tarea nueva. No se acepta el id enviado por el cliente.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskNuevo"}}}
        },
        "responses": {
          "201": {
            "description": "Tarea creada",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Task"}}}
          },
          "400": {"$ref": "#/components/responses/BadJson"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "422": {"$ref": "#/components/responses/ValidationError"}
        }
      }
    },
    "/login": {
      "post": {
        "security": [],
        "tags": ["auth"],
        "summary": "Iniciar sesión",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Credenciales"}}}
        },
        "responses": {
          "200": {"description": "Token JWT generado"},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/reportes": {
      "post": {
        "tags": ["tasks"],
        "summary": "Analizar una tarea con IA",
        "description": "Envía la descripción a Gemini. La API limita la espera y convierte los fallos externos en errores JSON.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReporteEntrada"}}}
        },
        "responses": {
          "200": {
            "description": "Análisis generado",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReporteSalida"}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "422": {"$ref": "#/components/responses/ValidationError"},
          "502": {"$ref": "#/components/responses/BadGateway"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"},
          "504": {"$ref": "#/components/responses/GatewayTimeout"}
        }
      }
    },
    "/tasks/{id}": {
      "parameters": [{
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Identificador entero de la tarea",
        "schema": {"type": "integer", "minimum": 1}
      }],
      "get": {
        "tags": ["tasks"],
        "summary": "Consultar tarea",
        "responses": {
          "200": {
            "description": "Tarea encontrada",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Task"}}}
          },
          "404": {"$ref": "#/components/responses/NotFound"},
          "422": {"$ref": "#/components/responses/ValidationError"}
        }
      },
      "put": {
        "tags": ["tasks"],
        "summary": "Reemplazar tarea",
        "description": "Reemplaza todos los campos de la tarea. Es idempotente.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskNuevo"}}}
        },
        "responses": {
          "200": {
            "description": "Tarea reemplazada",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Task"}}}
          },
          "400": {"$ref": "#/components/responses/BadJson"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "422": {"$ref": "#/components/responses/ValidationError"}
        }
      },
      "delete": {
        "tags": ["tasks"],
        "summary": "Borrar tarea",
        "responses": {
          "204": {"description": "Tarea borrada sin cuerpo"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "422": {"$ref": "#/components/responses/ValidationError"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Credenciales": {
        "type": "object",
        "required": ["usuario", "clave"],
        "properties": {
          "usuario": {"type": "string", "example": "ana"},
          "clave": {"type": "string", "format": "password", "example": "ana12345"}
        }
      },
      "ReporteEntrada": {
        "type": "object",
        "required": ["descripcion"],
        "properties": {
          "descripcion": {"type": "string", "minLength": 2, "maxLength": 300, "example": "La tarea vence pronto"}
        }
      },
      "ReporteSalida": {
        "type": "object",
        "required": ["resumen", "prioridad"],
        "properties": {
          "resumen": {"type": "string", "example": "Revisar y entregar la tarea pronto"},
          "prioridad": {"type": "string", "enum": ["baja", "media", "alta"], "example": "alta"}
        }
      },
      "TaskNuevo": {
        "type": "object",
        "required": ["titulo", "estado", "prioridad", "fecha_limite"],
        "properties": {
          "titulo": {"type": "string", "minLength": 3, "maxLength": 100, "example": "Entregar practica"},
          "estado": {"type": "string", "enum": ["pendiente", "en_progreso", "terminada"], "example": "pendiente"},
          "prioridad": {"type": "integer", "minimum": 1, "maximum": 5, "example": 3},
          "fecha_limite": {"type": "string", "format": "date", "description": "AAAA-MM-DD y no anterior a hoy", "example": "2026-11-06"}
        }
      },
      "Task": {
        "allOf": [
          {"$ref": "#/components/schemas/TaskNuevo"},
          {"type": "object", "required": ["id"], "properties": {"id": {"type": "integer", "example": 1}}}
        ]
      },
      "Error": {
        "type": "object",
        "required": ["error", "detalles"],
        "properties": {
          "error": {"type": "string", "example": "Los datos de la tarea no son válidos."},
          "detalles": {"type": "array", "items": {"type": "string"}, "example": ["titulo: es obligatorio"]}
        }
      }
    },
    "responses": {
      "Unauthorized": {"description": "Falta el token o las credenciales no son válidas", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Forbidden": {"description": "El rol no tiene permiso", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "BadJson": {"description": "El cuerpo no es un JSON válido", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "ValidationError": {"description": "Los datos o el id no cumplen las reglas", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "NotFound": {"description": "La tarea no existe", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Conflict": {"description": "Ya existe una tarea con el mismo título y fecha", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
      ,"BadGateway": {"description": "La IA no está disponible o respondió de forma inválida", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
      ,"ServiceUnavailable": {"description": "Falta configurar la integración con IA", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
      ,"GatewayTimeout": {"description": "La IA excedió el tiempo máximo", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    }
  }
}
