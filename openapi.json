{
  "openapi": "3.0.3",
  "info": {
    "title": "Gestor personal de tareas",
    "version": "1.0.0",
    "description": "CRUD de tareas con SQLite, login con JWT y dos endpoints con IA (Gemini). Todos los errores responden {\"error\", \"detalles\"}. Si falta la variable JWT_SECRET, cualquier ruta responde 503; un error inesperado responde 500 sin trazas. Catálogo completo en docs/errores.md."
  },
  "security": [{"bearerAuth": []}],
  "servers": [
    {"url": "http://127.0.0.1:8010", "description": "Servidor local PHP"}
  ],
  "tags": [
    {"name": "auth", "description": "Autenticación"},
    {"name": "tasks", "description": "Tareas del usuario autenticado"},
    {"name": "ia", "description": "Ayuda de la IA (Gemini). Timeout de 5 s y reintentos solo ante fallas pasajeras"}
  ],
  "paths": {
    "/tasks": {
      "get": {
        "tags": ["tasks"],
        "summary": "Listar tareas",
        "responses": {
          "200": {
            "description": "Lista de tareas del usuario actual (el admin ve todas)",
            "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Task"}}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      },
      "post": {
        "tags": ["tasks"],
        "summary": "Crear tarea",
        "description": "Crea una tarea nueva. No se acepta el id enviado por el cliente.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskNuevo"}}}
        },
        "responses": {
          "201": {
            "description": "Tarea creada",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Task"}}}
          },
          "400": {"$ref": "#/components/responses/BadJson"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "422": {"$ref": "#/components/responses/ValidationError"}
        }
      }
    },
    "/login": {
      "post": {
        "security": [],
        "tags": ["auth"],
        "summary": "Iniciar sesión",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Credenciales"}}}
        },
        "responses": {
          "200": {
            "description": "Token JWT generado (HS256, vence en 30 minutos)",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Token"}}}
          },
          "400": {"$ref": "#/components/responses/BadJson"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "422": {"$ref": "#/components/responses/ValidationError"}
        }
      }
    },
    "/reportes": {
      "post": {
        "tags": ["ia"],
        "summary": "Analizar una tarea con IA",
        "description": "Envía la descripción a Gemini, que le asigna prioridad (alta, media o baja) y la resume. Timeout de 5 s; 2 intentos, reintenta solo 429 y 503.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReporteEntrada"}}}
        },
        "responses": {
          "200": {
            "description": "Análisis generado",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReporteSalida"}}}
          },
          "400": {"$ref": "#/components/responses/BadJson"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "422": {"$ref": "#/components/responses/ValidationError"},
          "502": {"$ref": "#/components/responses/BadGateway"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"},
          "504": {"$ref": "#/components/responses/GatewayTimeout"}
        }
      }
    },
    "/tareas/prioridad": {
      "post": {
        "tags": ["ia"],
        "summary": "Sugerir la prioridad de una tarea con IA",
        "description": "Envía solo el título a Gemini, que sugiere una prioridad (alta, media o baja) y una razón corta. No guarda nada. Timeout de 5 s; hasta 3 intentos, reintenta 429, 500, 502, 503 y 504 esperando 0.5 s y 1 s. El timeout no se reintenta.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PrioridadEntrada"}}}
        },
        "responses": {
          "200": {
            "description": "Prioridad sugerida",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PrioridadSalida"}}}
          },
          "400": {"$ref": "#/components/responses/BadJson"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "422": {"$ref": "#/components/responses/ValidationError"},
          "502": {"$ref": "#/components/responses/BadGateway"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"},
          "504": {"$ref": "#/components/responses/GatewayTimeout"}
        }
      }
    },
    "/tasks/{id}": {
      "parameters": [{
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Identificador entero de la tarea",
        "schema": {"type": "integer", "minimum": 1}
      }],
      "get": {
        "tags": ["tasks"],
        "summary": "Consultar tarea",
        "responses": {
          "200": {
            "description": "Tarea encontrada",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Task"}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "422": {"$ref": "#/components/responses/ValidationError"}
        }
      },
      "put": {
        "tags": ["tasks"],
        "summary": "Reemplazar tarea",
        "description": "Reemplaza todos los campos de la tarea. Es idempotente. Solo admin.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskNuevo"}}}
        },
        "responses": {
          "200": {
            "description": "Tarea reemplazada",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Task"}}}
          },
          "400": {"$ref": "#/components/responses/BadJson"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "422": {"$ref": "#/components/responses/ValidationError"}
        }
      },
      "patch": {
        "tags": ["tasks"],
        "summary": "Cambiar parte de la tarea",
        "description": "Cambia solo los campos enviados. El usuario solo cambia lo suyo; el admin cualquiera.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskCambio"}}}
        },
        "responses": {
          "200": {
            "description": "Tarea actualizada",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Task"}}}
          },
          "400": {"$ref": "#/components/responses/BadJson"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "422": {"$ref": "#/components/responses/ValidationError"}
        }
      },
      "delete": {
        "tags": ["tasks"],
        "summary": "Borrar tarea",
        "responses": {
          "204": {"description": "Tarea borrada sin cuerpo"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "422": {"$ref": "#/components/responses/ValidationError"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Credenciales": {
        "type": "object",
        "required": ["usuario", "clave"],
        "properties": {
          "usuario": {"type": "string", "example": "ana"},
          "clave": {"type": "string", "format": "password", "example": "ana12345"}
        }
      },
      "Token": {
        "type": "object",
        "required": ["access_token", "token_type"],
        "properties": {
          "access_token": {"type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."},
          "token_type": {"type": "string", "example": "bearer"}
        }
      },
      "PrioridadEntrada": {
        "type": "object",
        "required": ["titulo"],
        "properties": {
          "titulo": {"type": "string", "minLength": 3, "maxLength": 100, "example": "Entregar el reporte de practicas hoy mismo"}
        }
      },
      "PrioridadSalida": {
        "type": "object",
        "required": ["prioridad", "razon"],
        "properties": {
          "prioridad": {"type": "string", "enum": ["alta", "media", "baja"], "example": "alta"},
          "razon": {"type": "string", "maxLength": 200, "example": "Vence hoy y es una entrega académica."}
        }
      },
      "ReporteEntrada": {
        "type": "object",
        "required": ["descripcion"],
        "properties": {
          "descripcion": {"type": "string", "minLength": 2, "maxLength": 300, "example": "La tarea vence pronto"}
        }
      },
      "ReporteSalida": {
        "type": "object",
        "required": ["resumen", "prioridad"],
        "properties": {
          "resumen": {"type": "string", "example": "Revisar y entregar la tarea pronto"},
          "prioridad": {"type": "string", "enum": ["baja", "media", "alta"], "example": "alta"}
        }
      },
      "TaskNuevo": {
        "type": "object",
        "required": ["titulo", "estado", "prioridad", "fecha_limite"],
        "properties": {
          "titulo": {"type": "string", "minLength": 3, "maxLength": 100, "example": "Entregar practica"},
          "estado": {"type": "string", "enum": ["pendiente", "en_progreso", "terminada"], "example": "pendiente"},
          "prioridad": {"type": "integer", "minimum": 1, "maximum": 5, "example": 3},
          "fecha_limite": {"type": "string", "format": "date", "description": "AAAA-MM-DD y no anterior a hoy", "example": "2026-12-15"}
        }
      },
      "TaskCambio": {
        "type": "object",
        "properties": {
          "titulo": {"type": "string", "minLength": 3, "maxLength": 100, "example": "Entregar practica corregida"},
          "estado": {"type": "string", "enum": ["pendiente", "en_progreso", "terminada"], "example": "terminada"},
          "prioridad": {"type": "integer", "minimum": 1, "maximum": 5, "example": 4},
          "fecha_limite": {"type": "string", "format": "date", "description": "AAAA-MM-DD y no anterior a hoy", "example": "2026-12-16"}
        }
      },
      "Task": {
        "allOf": [
          {"$ref": "#/components/schemas/TaskNuevo"},
          {"type": "object", "required": ["id"], "properties": {"id": {"type": "integer", "example": 1}}}
        ]
      },
      "Error": {
        "type": "object",
        "required": ["error", "detalles"],
        "properties": {
          "error": {"type": "string", "example": "Los datos de la tarea no son válidos."},
          "detalles": {"type": "array", "items": {"type": "string"}, "example": ["titulo: es obligatorio"]}
        }
      }
    },
    "responses": {
      "Unauthorized": {"description": "Falta el token o las credenciales no son válidas", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Forbidden": {"description": "El rol no tiene permiso", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "BadJson": {"description": "El cuerpo no es un JSON válido", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "ValidationError": {"description": "Los datos o el id no cumplen las reglas", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "NotFound": {"description": "La tarea no existe", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Conflict": {"description": "Ya existe una tarea con el mismo título y fecha", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
      ,"BadGateway": {"description": "La IA no está disponible o respondió de forma inválida", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
      ,"ServiceUnavailable": {"description": "Falta configurar la integración con IA", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
      ,"GatewayTimeout": {"description": "La IA excedió el tiempo máximo", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    }
  }
}
